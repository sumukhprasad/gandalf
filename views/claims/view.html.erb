<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta http-equiv="x-ua-compatible" content="ie=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	
	<title>gandalf</title>

	<%= erb :"_includes/head" %>
	<script id="MathJax-script" src="https://cdn.jsdelivr.net/npm/mathjax@4/tex-svg.js"></script>
</head>

<body>
	<%= erb :"_includes/navigation" %>
	
	<main>

		<p>
			<a href="/groups/<%= @group.slug %>"><< back to group</a>
		</p>
		
		<h1><%= @claim.statement %></h1>

		<p>
			posted at <%= @claim.created_at.strftime("%b %d, %Y, %-I:%M %p") %> by <a href="/user/<%= @claim.user.username %>"><strong><%= @claim.user.username %></strong></a>

		<span class="status">
			<%= @claim.initial_reaction %> initial reaction
		</span> 

		<span class="status">
			<%= @claim.status %>
		</span>
	
		<% if @is_moderator && @claim.status!="completed" %>
			| <a href="/groups/<%= @group.slug %>/claims/<%= @claim.id %>/assignment">
				View/edit assignment
			</a>
		<% end %>
		</p>

		<div>
			<h3>Context</h3>
			<div id="tex">
				<%= @claim.context %>
			</div>
		</div>
		<script>
			MathJax.typesetPromise([document.getElementById("tex")]);
		</script>

		<% if @can_edit %>
		<p>
			<a href="/groups/<%= @group.slug %>/claims/<%= @claim.id %>/edit">
				edit claim
			</a>
		</p>
		<% end %>
		
		
		<hr>
		
		<% if @claim.status=="completed" %>
		
		<h1>Verification</h1>

		<p>
			posted at <%= @claim.completed_assignment.verification.submitted_at.strftime("%b %d, %Y, %-I:%M %p") %> by <a href="/user/<%= @claim.completed_assignment.verifier.username %>"><strong><%= @claim.completed_assignment.verifier.username %></strong></a>
			
			<% if @claim.completed_assignment.verification.accepted_at %>
				<p>
					accepted by
					<%= @claim.completed_assignment.verification.accepted_by_user .username %>
				</p>
			<% elsif @can_edit %>
				<form action="/groups/<%= @group.slug %>/claims/<%= @claim.id %>/accept_verification" method="post">
					<button type="submit">Accept verification</button>
				</form>
			<% end %>
		</p>
		
		<% @verification = @claim.completed_assignment.verification %>

		
		<h2>Details</h2>
		<p>
			<strong>Interpreted claim:</strong><br>
			<%= @verification.interpreted_claim %>
		</p>
		
		<p>
			Verdict: <strong><%= @verification.verdict %></strong><br>
			Confidence: <strong><%= @verification.confidence %></strong>
		</p>
		
		<p>
			<strong>Reasoning:</strong><br>
			<%= @verification.explanation %>
		</p>
		
		<p>
			<strong>Assumptions made:</strong><br>
			<%= @verification.assumptions %>
		</p>
		
		<p>
			<strong>Limitations</strong><br>
			<%= @verification.limitations %>
		</p>
		
		<% if @verification.issues %>
			<h2>Sources</h2>
			<% @verification.sources.each do |source| %>
			<div class="boxed">
				<h3><%= source.title %> (<%=	source.author == "" ? "no author" : source.author %>)</h3>
				<p>
					URL: <a href="<%= source.url %>"><%= source.url %></a><br>
					Type: <%= source.source_type %><br>
					Relation: <%= source.relation %>
				</p>
				
				<p>
					Excerpt (if any):<br><%= source.excerpt %>
				</p>
				
				<p>
					Location (if any):<br><%= source.location %>
				</p>
				
				<p>
					Relevance (if any):<br><%= source.relevance %>
				</p>
			</div>
			<% end %>
		<% end %>
		
		

		<% if @verification.issues %>
			<h2>Problems with claim (if any)</h2>
			<ul>
				<% @verification.issues.each do |problem| %>
					<li><%= problem.issue %></li>
				<% end %>
			</ul>
		<% end %>
			
			
		<% end %>
		
		
	</main>
	

	<%= erb :"_includes/footer" %>
</body>
</html>