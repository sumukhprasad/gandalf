<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta http-equiv="x-ua-compatible" content="ie=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	
	<title>gandalf</title>

	<%= erb :"_includes/head" %>
</head>

<body>
	<%= erb :"_includes/navigation" %>
	<%= erb :"_includes/admin/navigation" %>
	
	
	<main>
		<h1>View User <i><%= @user.username %></i></h1>

		<p>
			<strong>Email:</strong>
			<%= @user.email %>
		</p>

		<p>
			<strong>Role:</strong>
			<%= @user.role %>
		</p>

		<p>
			<strong>Active?:</strong>
			<%= @user.active ? "active" : "inactive" %>
			<form method="post" action="/admin/users/<%= @user.username %>/toggle">
				<button type="submit">
					<%= @user.active ? "deactivate" : "activate" %>
				</button>
			</form>
		</p>
		
		<p>
			<strong>Password set?:</strong>
			<%= @user.token_hash == "" ? "No" : "Yes" %>
			<% if @user.token_hash != "" %>
			<form method="post" action="/admin/users/<%= @user.username %>/reset">
				<button type="submit">
					Prompt for password
				</button>
			</form>
			<% end %>
		</p>

		<p>
			<strong>Created:</strong>
			<%= @user.created_at %>
		</p>

		<p>
			<a href="/admin/users/<%= @user.username %>/edit">edit</a>
		</p>

		
		
	</main>

	<%= erb :"_includes/footer" %>
</body>
</html>