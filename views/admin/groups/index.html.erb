<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta http-equiv="x-ua-compatible" content="ie=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	
	<title>gandalf</title>

	<%= erb :"_includes/head" %>
</head>

<body>
	<%= erb :"_includes/navigation" %>
	<%= erb :"_includes/admin/navigation" %>
	
	
	<main>
		<h1>Groups</h1>
		
		<table>
			<thead>
				<tr>
					<th>
						id
					</th>
					<th>
						name
					</th>
					<th>
						slug
					</th>
					<th>
						actions
					</th>
				</tr>
			</thead>
			<tbody>
				<% @groups.each do |g| %>
					<tr>
						<td>
							<%= g.id %>
						</td>
						<td>
							<b><%= g.name %></b>
						</td>
						<td>
							<code><%= g.slug %></code>
						</td>
						<td>
							<a href="/admin/groups/<%= g.slug %>">View</a> /
							<a href="/admin/groups/<%= g.slug %>/edit">Edit</a>
						</td>
				  </tr>
				<% end %>
			</tbody>
		</table>
		
		
		<a href="/admin/groups/create_group">Create a new group...</a>
	</main>

	<%= erb :"_includes/footer" %>
</body>
</html>
