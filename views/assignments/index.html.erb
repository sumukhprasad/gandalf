<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta http-equiv="x-ua-compatible" content="ie=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	
	<title>gandalf</title>

	<%= erb :"_includes/head" %>
</head>

<body>
	<%= erb :"_includes/navigation" %>
	
	<main>
		<h2>My assignments</h2>

		
		<% if @assignments.empty?  %>
			No assignments
		<% else  %>
			<table>
				<thead>
					<tr>
						<th>Assigned at</th>
						<th>Group</th>
						<th>Statement</th>
						<th>Assigned by</th>
						<th>Why?</th>
						<th>Claim Status</th>
						<th>Assignment Status</th>
						<th>Verify</th>
					</tr>
				</thead>
				<tbody>
					<% @assignments.each do |assignment| %>
						<% claim = Claim.where(id: assignment.claim_id).first %>
						<% createdby_user = User.where(id: assignment.created_by).first %>
						<tr>
							<td>
								<%= assignment.assigned_at.strftime("%b %d, %Y, %-I:%M %p") %>
							</td>
							<td>
								<a href="/groups/<%= claim.group.slug %>">
									<%= claim.group.name %>
								</a>
							</td>
							<td>
								<a href="/groups/<%= claim.group.slug %>/claims/<%= claim.id %>">
									<span style="font-size:1.5em"><%= claim.statement %></span>
								</a>
							</td>
							<td>
								<a href="/user/<%= createdby_user.username %>">
									<%= createdby_user.username %>
								</a>
							</td>
							<td>
								<%= assignment.reason %>
							</td>
							<td>
								<%= claim.status %>
							</td>
							<td>
								<%= assignment.status %>
							</td>
		
							<% if claim.status != "completed"  %>
							<td>
								<a href="/verify_assignment/<%= assignment.id %>">
									Verify >
								</a>
							</td>
							<% elsif assignment.status == "completed" %>
							<td>
								<span style="color: green">Verified already.</span>
							</td>
							<% elsif assignment.status == "rescinded" %>
							<td>
								<span style="color: red">RESCINDED!</span>
							</td>
							<% elsif assignment.status == "rescinded" %>
							<td>
								<span style="opacity: 0.4">...</span>
							</td>
							<% end %>
						</tr>
					<% end %>
				</tbody>
			</table>
		<% end %>
	</main>
	

	<%= erb :"_includes/footer" %>
</body>
</html>